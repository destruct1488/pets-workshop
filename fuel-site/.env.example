# Copy to .env.local for local work. On the hosting, set these as environment
# variables. Never commit real values.

# Public address of the site, used only by `npm run set-webhook`.
SITE_URL=https://example.com

# Telegram bot (create it with @BotFather).
TELEGRAM_BOT_TOKEN=
# Any random string of letters, digits, "_" or "-" (up to 256 chars). Telegram
# sends it with every request and the site rejects requests without it.
TELEGRAM_WEBHOOK_SECRET=
# Comma-separated Telegram user IDs allowed to send price photos.
TELEGRAM_ALLOWED_USER_IDS=

# Claude API key and (optionally) the model that reads the price photos.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Storage for prices. Without these the site keeps prices in .data/ on disk,
# which is fine locally but is wiped on serverless hosting. Use an Upstash
# Redis database (free plan is enough) in production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
